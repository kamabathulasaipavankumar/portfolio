# Copy to .env.local for `vercel dev`, and add the same values in
# Vercel → Project → Settings → Environment Variables. Never commit real keys.

# Required. Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-20b. Check https://console.groq.com/docs/models before changing.
GROQ_MODEL=openai/gpt-oss-20b

# Optional. Extra origins allowed to call /api/chat, comma-separated (same-origin is always allowed).
# ALLOWED_ORIGINS=https://www.example.com
